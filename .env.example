PORT=3000
# 127.0.0.1 = bind localhost + restrict API/MCP to local clients
# 0.0.0.0     = bind all interfaces, no API/MCP restriction
HOST=127.0.0.1
DB_PATH=data.sqlite

# Optional: HTTP(S) proxy for outbound fetches (undici EnvHttpProxyAgent)
# HTTP_PROXY=http://127.0.0.1:9080
# HTTPS_PROXY=http://127.0.0.1:9080
# NO_PROXY=localhost,127.0.0.1

# Optional: OpenAI-compatible API via LangChain (when filter.json prompt is set)
# LLM_BASE_URL=https://api.openai.com
# LLM_API_KEY=
# LLM_MODEL_NAME=gpt-4o-mini

# WechatRss API
# WECHATRSS_API_KEY=
# WECHATRSS_API_SECRET=